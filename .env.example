# Copy to .env and fill in. .env is git-ignored: never commit real credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hackathon_db
# Optional: full path to the mysql command-line client if it is not on PATH, e.g.
# MYSQL_CLIENT=C:/Program Files/MySQL/MySQL Server 8.4/bin/mysql.exe
